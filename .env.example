
# ========= OpenAI =========
OPENAI_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small   # أو text-embedding-3-large للجودة الأعلى
OPENAI_TIMEOUT=60

# ========= Paths =========
DATA_RAW_DIR=./data/raw
DATA_PROCESSED_DIR=./data/processed
CHROMA_PATH=./vectorstore

# ========= Vector Store =========
COLLECTION_NAME=academy_docs   # اسم المجموعة في Chroma

# ========= RAG Retrieval =========
RAG_SEARCH_TYPE=mmr            # options: similarity | mmr
RAG_SEARCH_K=4
RAG_MMR_LAMBDA=0.7             # 0..1؛ الأعلى = تنويع أكبر

# ========= Chunking / Splitting =========
CHUNK_SIZE=400                 # مبني على التوكنز لو استخدمت tiktoken
CHUNK_OVERLAP=80
SPLITTER_ENCODER=tiktoken      # tiktoken | char

# ========= UI (Gradio) =========
GRADIO_SHARE=false             # true لو عايز رابط عام (خلي بالك من الأمان)
GRADIO_USERNAME=               # فعّل Basic Auth بملء الاثنين
GRADIO_PASSWORD=

# ========= App Defaults =========
DEFAULT_LANGUAGE=auto          # auto | ar | en — يطابق لغة المستخدم
TEMPERATURE=0.3
LOG_LEVEL=INFO
